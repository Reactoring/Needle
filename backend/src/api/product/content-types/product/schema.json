{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Product",
    "description": "Fiche catalogue vinyle (separee de l'unite vendable)"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "tenant": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::tenant.tenant",
      "required": true
    },
    "productType": {
      "type": "enumeration",
      "enum": ["vinyl"],
      "default": "vinyl",
      "required": true
    },
    "title": {
      "type": "string",
      "required": true
    },
    "artist": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "coverKey": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "year": {
      "type": "integer",
      "min": 1900,
      "max": 2100
    },
    "country": {
      "type": "string"
    },
    "format": {
      "type": "string"
    },
    "catalogReference": {
      "type": "string"
    },
    "barcode": {
      "type": "string"
    },
    "discogsReleaseId": {
      "type": "string"
    },
    "discogsMasterId": {
      "type": "string"
    },
    "sellableUnits": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::sellable-unit.sellable-unit",
      "mappedBy": "product"
    }
  }
}
