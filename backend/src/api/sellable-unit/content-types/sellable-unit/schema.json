{
  "kind": "collectionType",
  "collectionName": "sellable_units",
  "info": {
    "singularName": "sellable-unit",
    "pluralName": "sellable-units",
    "displayName": "Sellable Unit",
    "description": "Exemplaire physique mis en vente (SKU genere cote backend)"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "tenant": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::tenant.tenant",
      "required": true
    },
    "product": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::product.product",
      "inversedBy": "sellableUnits",
      "required": true
    },
    "sku": {
      "type": "string",
      "unique": true
    },
    "price": {
      "type": "decimal",
      "required": true,
      "min": 0
    },
    "currency": {
      "type": "string",
      "default": "EUR",
      "required": true
    },
    "mediaCondition": {
      "type": "enumeration",
      "enum": [
        "mint",
        "near_mint",
        "very_good_plus",
        "very_good",
        "good_plus",
        "good",
        "fair",
        "poor"
      ]
    },
    "sleeveCondition": {
      "type": "enumeration",
      "enum": [
        "mint",
        "near_mint",
        "very_good_plus",
        "very_good",
        "good_plus",
        "good",
        "fair",
        "poor"
      ]
    },
    "sellerComment": {
      "type": "text"
    },
    "saleStatus": {
      "type": "enumeration",
      "enum": ["available", "reserved", "sold", "out_of_stock", "archived"],
      "default": "available",
      "required": true
    },
    "quantity": {
      "type": "integer",
      "default": 1,
      "min": 0,
      "required": true
    },
    "internalLocation": {
      "type": "string"
    },
    "channelListings": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::channel-listing.channel-listing",
      "mappedBy": "sellableUnit"
    }
  }
}
