# Server
HOST=0.0.0.0
PORT=1337

# Secrets Strapi — regenerer des valeurs uniques pour chaque environnement
# (ex: `node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"`)
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Database (PostgreSQL — voir docker-compose.yml a la racine du repo)
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=vinyl
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=strapi
DATABASE_SSL=false

# Admin (optionnel — pense pour le deploiement)
# Si ces deux variables sont definies et qu'aucun admin n'existe encore,
# un super admin est cree au demarrage et l'ecran public "creer le premier
# administrateur" n'est jamais expose. En local, laisser vide : Strapi
# proposera de creer le compte au premier acces a /admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Donnees de demonstration
# En developpement, mettre a false pour desactiver le seed automatique.
# Cette variable est toujours ignoree en production : utiliser npm run demo:setup.
DEMO_AUTO_SEED=true
# Origine autorisee a envoyer le cookie de session demo vers l'API.
FRONTEND_URL=http://localhost:5173

# Discogs
# La demo accepte uniquement le mode mock et n'effectue aucun appel reseau Discogs.
DISCOGS_MODE=mock
