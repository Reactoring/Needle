# Server
HOST=0.0.0.0
PORT=1337

# Secrets Strapi — regenerer des valeurs uniques pour chaque environnement
# (ex: `node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"`)
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Database (PostgreSQL — voir docker-compose.yml a la racine du repo)
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=vinyl
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=strapi
DATABASE_SSL=false

# Admin (optionnel — pense pour le deploiement)
# Si ces deux variables sont definies et qu'aucun admin n'existe encore,
# un super admin est cree au demarrage et l'ecran public "creer le premier
# administrateur" n'est jamais expose. En local, laisser vide : Strapi
# proposera de creer le compte au premier acces a /admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Discogs
# DISCOGS_MODE : "mock" (defaut, aucun appel reseau) ou "real" (recherche via l'API Discogs)
# En mode "real", seules les lectures (search/getRelease) touchent l'API ;
# la publication de listings reste simulee pour ne pas creer de vraies annonces.
DISCOGS_MODE=mock
# Token personnel Discogs (Settings > Developers), requis uniquement en mode "real"
DISCOGS_TOKEN=
