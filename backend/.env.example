# Server
HOST=0.0.0.0
PORT=1337

# Strapi secrets — generate unique values for every environment
# (for example: `node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"`)
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Database (PostgreSQL — see docker-compose.yml at the repository root)
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=vinyl
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=strapi
DATABASE_SSL=false

# Admin (optional — intended for deployment)
# If both variables are set and no admin exists yet, a super admin is created
# at startup and the public "create the first administrator" screen is never
# exposed. Leave these blank locally so Strapi offers account creation on the
# first visit to /admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Demo data
# Set to false in development to disable automatic seeding.
# This variable is always ignored in production: use npm run demo:setup.
DEMO_AUTO_SEED=true
# Origin allowed to send the demo session cookie to the API.
FRONTEND_URL=http://localhost:5173

# Discogs
# The demo accepts mock mode only and never sends a network request to Discogs.
DISCOGS_MODE=mock
