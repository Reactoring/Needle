# Marketplace test workflow — run in order with the VS Code REST Client extension
# (or copy the requests into Postman / curl).
#
# Replace the three variables below with documentIds printed by the startup seed,
# then with the identifiers returned by the create requests.

@baseUrl = http://localhost:1337/api
@tenantId = REMPLACER_PAR_DOCUMENT_ID_TENANT
@productId = REMPLACER_PAR_DOCUMENT_ID_PRODUCT
@unitId = REMPLACER_PAR_DOCUMENT_ID_UNIT

### 0. Open the passwordless demo session (REST Client keeps the cookie)
POST {{baseUrl}}/demo/session

### 1. Connector mode
GET {{baseUrl}}/discogs/info

### 2. Demo tenant (retrieve its documentId here if needed)
GET {{baseUrl}}/tenants?filters[slug][$eq]=demo-records

### 3. Search for a fictional release
GET {{baseUrl}}/discogs/search?tenantId={{tenantId}}&q=night transit

### 4. Attach release 910001 to the product
POST {{baseUrl}}/products/{{productId}}/attach-discogs-release
Content-Type: application/json

{ "tenantId": "{{tenantId}}", "releaseId": "910001" }

### 5. (Optional) Create a sellable unit — the backend allocates the SKU
POST {{baseUrl}}/sellable-units
Content-Type: application/json

{
  "data": {
    "tenant": "{{tenantId}}",
    "product": "{{productId}}",
    "price": 34.99,
    "currency": "EUR",
    "mediaCondition": "near_mint",
    "sleeveCondition": "very_good_plus",
    "saleStatus": "available",
    "quantity": 1
  }
}

### 6. Check the unit's marketplace completeness
POST {{baseUrl}}/sellable-units/{{unitId}}/check-discogs-completeness
Content-Type: application/json

{ "tenantId": "{{tenantId}}" }

### 7. Publish the unit to the mock marketplace
POST {{baseUrl}}/sellable-units/{{unitId}}/publish-discogs
Content-Type: application/json

{ "tenantId": "{{tenantId}}" }

### 8. List published marketplace listings
GET {{baseUrl}}/discogs/listings?tenantId={{tenantId}}&status=published

### 9. Simulate a sale (unit -> sold, listing -> removed)
POST {{baseUrl}}/sellable-units/{{unitId}}/simulate-discogs-sale
Content-Type: application/json

{ "tenantId": "{{tenantId}}" }

### 10. Read the tenant-scoped synchronization event log
GET {{baseUrl}}/marketplace-sync-events?filters[tenant][documentId][$eq]={{tenantId}}&sort=happenedAt:desc&pagination[pageSize]=20
